scalar JSON

# =========================================================
# QUERY
# =========================================================

type Query {
    _health: String

    me: User

    # -------------------------
    # Cards
    # -------------------------

    cards: [Card!]!
    cardBySlug(slug: String!): Card
    cardTemplateById(id: ID!): CardTemplate
    cardTemplates(occasion: Occasion): [CardTemplate!]!

    # -------------------------
    # Websites
    # -------------------------

    websiteTemplates(occasion: Occasion): [WebsiteTemplate!]!

    websiteTemplateById(id: ID!): WebsiteTemplate
}


# =========================================================
# MUTATION
# =========================================================

type Mutation {

    # -------------------------
    # Authentication
    # -------------------------

    createUser(input: CreateUserInput!): User!

    login(input: LoginInput!): User!

    verifyEmail(token: String!): User!

    logout: Boolean!


    # -------------------------
    # Cards
    # -------------------------

    createCard(
        input: CreateCardInput!
    ): Card!

    updateCard(
        id: ID!
        input: UpdateCardInput!
    ): Card!

    publishCard(
        id: ID!
    ): Card!

    archiveCard(
        id: ID!
    ): Card!


    # -------------------------
    # Websites
    # -------------------------

    createWebsite(
        input: CreateWebsiteInput!
    ): Website!


    # -------------------------
    # Media
    # -------------------------

    generateCloudinaryUploadSignature: CloudinaryUploadSignature!
}


# =========================================================
# USER
# =========================================================

input CreateUserInput {
    name: String!
    email: String!
    password: String!
}


input LoginInput {
    email: String!
    password: String!
}


type User {
    id: ID!
    name: String!
    email: String!
}


# =========================================================
# CARD
# =========================================================

type Card {
    id: ID!

    title: String!

    recipientName: String!

    recipientEmail: String

    recipientPhone: String

    occasion: Occasion!

    customOccasion: String

    message: String

    coverImageUrl: String

    status: Status!

    template: CardTemplate

    publicSlug: String!

    createdAt: String!

    updatedAt: String!
}


input CreateCardInput {

    title: String!

    recipientName: String!

    recipientEmail: String

    recipientPhone: String

    occasion: Occasion!

    customOccasion: String

    message: String

    coverImageUrl: String

    templateId: ID

    customSlug: String

    saveAsDraft: Boolean!
}


input UpdateCardInput {

    title: String

    recipientName: String

    recipientEmail: String

    recipientPhone: String

    occasion: Occasion

    customOccasion: String

    message: String

    coverImageUrl: String

    templateId: ID

    customSlug: String
}


# =========================================================
# CARD TEMPLATE
# =========================================================

type CardTemplate {

    id: ID!

    name: String!

    style: TemplateStyle!

    previewImageUrl: String!

    occasion: Occasion!

    active: Boolean!
}


# =========================================================
# WEBSITE
# =========================================================

type Website {

    id: ID!

    title: String!

    recipientName: String!

    recipientEmail: String

    recipientPhone: String

    occasion: Occasion!

    customOccasion: String

    status: Status!

    publicSlug: String!

    content: JSON

    template: WebsiteTemplate!
}


input CreateWebsiteInput {

    title: String!

    recipientName: String!

    recipientEmail: String

    recipientPhone: String

    occasion: Occasion!

    customOccasion: String

    templateId: ID!

    content: JSON
}


# =========================================================
# WEBSITE TEMPLATE
# =========================================================

type WebsiteTemplate {
    id: ID!
    name: String!
    style: TemplateStyle!
    previewImageUrl: String!
    occasion: Occasion!
    active: Boolean!
    websiteSections: [WebsiteSection!]!
}


# =========================================================
# WEBSITE SECTION
# =========================================================

type WebsiteSection {

    id: ID!

    name: String!

    sectionKey: String!

    displayOrder: Int!

    fieldSchema: JSON
}


# =========================================================
# SHARED ENUMS
# =========================================================

enum TemplateStyle {

    EDITORIAL

    PHOTO

    PLAYFUL

    ELEGANT

    BOLD
}


enum Occasion {

    BIRTHDAY

    WEDDING

    ANNIVERSARY

    GRADUATION

    APPRECIATION

    RETIREMENT

    CUSTOM
}


enum Status {

    DRAFT

    PUBLISHED

    ARCHIVED
}


# =========================================================
# CLOUDINARY
# =========================================================

type CloudinaryUploadSignature {

    signature: String!

    timestamp: String!

    apiKey: String!

    cloudName: String!

    folder: String!
}